PORT=3001
# Log verbosity: error, info (default), or debug
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:password@localhost:5432/domx
# Postgres pool size. Default 10 matches the pg default.
# DATABASE_POOL_MAX=10
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*
ENCRYPTION_KEY=base64-encoded-32-byte-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Cloud Translation API v2 key. Used for German-to-English chat history and the fan archive.
# Restrict the key to the Cloud Translation API. Do not put it in the desktop app.
GOOGLE_TRANSLATE_API_KEY=
DOMX_ELECTRON_SERVICE_KEY=change-me-in-production
MALOUM_SUPABASE_URL=https://srswgacczfgjttwdpuia.supabase.co
MALOUM_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4zljSqmEuxGuqPttJAK_kg_XzInyyJ9
# Dedicated static US residential proxy for all Maloum traffic (required unless a per-account proxy is set)
MALOUM_PROXY_URL=http://user:pass@host:port
# Cloudflare bypass (same-server Docker) — PRIMARY path for Maloum login + API
# Default: http://127.0.0.1:8000 — set to false/off to use undici only
# MALOUM_CF_BYPASS_URL=http://127.0.0.1:8000
# Playwright only if bypass is down and undici is CF-blocked:
# MALOUM_BROWSER_HEADLESS=true
# Optional disk cache for Maloum vault/chat thumbnails
# Default: backend/data/maloum-media-cache
# MALOUM_MEDIA_CACHE_DIR=
# MALOUM_MEDIA_CACHE_TTL_MS=86400000
# MALOUM_MEDIA_CACHE_MAX_FILES=2000
# Dedicated static residential proxy for all 4based traffic (required unless a per-account proxy is set)
FOURBASED_PROXY_URL=http://user:pass@host:port
# Dedicated static residential proxy for all Fansly traffic (required unless a per-account proxy is set)
FANSLY_PROXY_URL=http://user:pass@host:port
# Optional disk cache for 4based vault/chat media
# Default: backend/data/4based-media-cache
# FOURBASED_MEDIA_CACHE_DIR=
# Telegram MTProto (from https://my.telegram.org) — no proxy required
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Private Backblaze B2 bucket for Telegram vault media (S3-compatible API)
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# Public API origin used for copyable webhook URLs (no trailing slash)
# PUBLIC_API_URL=https://api.low7labs.cloud
